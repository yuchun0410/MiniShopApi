<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.demo.mapper.MemberMapper">

    <resultMap id="MemberResultMap" type="com.example.demo.model.Member">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="email" column="email"/>
        <result property="name" column="name"/>
        <result property="role" column="role"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.example.demo.model.Member" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO member (username, password, email, name, role, created_at)
        VALUES (#{username}, #{password}, #{email}, #{name}, #{role}, #{createdAt})
    </insert>

    <update id="update" parameterType="com.example.demo.model.Member">
        UPDATE member
        SET username = #{username},
            password = #{password},
            email = #{email},
            name = #{name},
            role = #{role}
        WHERE id = #{id}
    </update>

    <select id="findById" parameterType="long" resultMap="MemberResultMap">
        SELECT * FROM member WHERE id = #{id}
    </select>

    <select id="findByUsername" parameterType="string" resultMap="MemberResultMap">
        SELECT * FROM member WHERE username = #{username}
    </select>

    <select id="countByUsername" parameterType="string" resultType="int">
        SELECT COUNT(*) FROM member WHERE username = #{username}
    </select>

    <select id="findAll" resultMap="MemberResultMap">
        SELECT * FROM member
    </select>

    <delete id="deleteById" parameterType="long">
        DELETE FROM member WHERE id = #{id}
    </delete>

    <!-- 換頁 + 查詢用：keyword 有值時比對 username 或 name，沒有值就撈全部 -->
    <select id="findPage" resultMap="MemberResultMap">
        SELECT * FROM member
        <if test="keyword != null and keyword != ''">
            WHERE username LIKE CONCAT('%', #{keyword}, '%')
               OR name LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY id LIMIT #{limit} OFFSET #{offset}
    </select>

    <!-- 換頁 + 查詢用：算符合條件的總筆數，前端要靠這個算總頁數 -->
    <select id="count" resultType="long">
        SELECT COUNT(*) FROM member
        <if test="keyword != null and keyword != ''">
            WHERE username LIKE CONCAT('%', #{keyword}, '%')
               OR name LIKE CONCAT('%', #{keyword}, '%')
        </if>
    </select>

</mapper>
